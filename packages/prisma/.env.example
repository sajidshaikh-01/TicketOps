# Used directly by the Prisma CLI (migrate, generate, seed, studio) when run
# from inside packages/prisma. This is a SEPARATE file from the four app-level
# .env files - the Prisma CLI only reads .env files next to the schema it's
# using, not from apps/events-api/.env or any other app folder.
DATABASE_URL=postgresql://ticketops:ticketops@localhost:5432/ticketops?schema=public
