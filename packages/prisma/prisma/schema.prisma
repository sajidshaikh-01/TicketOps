// TicketOps - Shared Prisma Schema
// This schema is shared across events-api, admin-api, and bookings-worker.
// All three services generate the same @ticketops/prisma client from this single source of truth.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  ORGANIZER
  CUSTOMER
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  bookings      Booking[]
  eventsCreated Event[]        @relation("EventOrganizer")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Events & Seats
// ---------------------------------------------------------------------------

model Event {
  id            String   @id @default(uuid())
  title         String
  description   String?
  category      String
  venue         String
  city          String
  startsAt      DateTime @map("starts_at")
  endsAt        DateTime @map("ends_at")
  bannerUrl     String?  @map("banner_url")
  basePrice     Decimal  @map("base_price") @db.Decimal(10, 2)
  totalSeats    Int      @map("total_seats")
  isPublished   Boolean  @default(false) @map("is_published")
  organizerId   String   @map("organizer_id")
  organizer     User     @relation("EventOrganizer", fields: [organizerId], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  seats    Seat[]
  bookings Booking[]

  @@index([category])
  @@index([city])
  @@index([startsAt])
  @@map("events")
}

model Seat {
  id        String     @id @default(uuid())
  eventId   String     @map("event_id")
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seatCode  String     @map("seat_code") // e.g. "A1", "B12"
  section   String     @default("GENERAL")
  priceTier Decimal    @default(1.0) @map("price_tier") @db.Decimal(4, 2) // multiplier on basePrice
  status    SeatStatus @default(AVAILABLE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  bookingSeats BookingSeat[]

  @@unique([eventId, seatCode])
  @@index([eventId, status])
  @@map("seats")
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------

model Booking {
  id            String        @id @default(uuid())
  bookingRef    String        @unique @map("booking_ref") // e.g. TKT-482913
  eventId       String        @map("event_id")
  event         Event         @relation(fields: [eventId], references: [id])
  userId        String?       @map("user_id") // nullable: guest checkout supported
  user          User?         @relation(fields: [userId], references: [id])
  customerName  String        @map("customer_name")
  customerEmail String        @map("customer_email")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  status        BookingStatus @default(PENDING)
  qrCodeUrl     String?       @map("qr_code_url")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  seats         BookingSeat[]
  notifications Notification[]
  jobs          BookingJob[]

  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@map("bookings")
}

model BookingSeat {
  id        String  @id @default(uuid())
  bookingId String  @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatId    String  @map("seat_id")
  seat      Seat    @relation(fields: [seatId], references: [id])
  priceAtBooking Decimal @map("price_at_booking") @db.Decimal(10, 2)

  @@unique([bookingId, seatId])
  @@map("booking_seats")
}

// Outbox-style job queue row. bookings-worker polls/consumes these (mirrored
// onto a Redis list for fast pickup, but the DB row is the durable source of
// truth so a Redis flush can never silently lose a booking).
model BookingJob {
  id          String    @id @default(uuid())
  bookingId   String    @map("booking_id")
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("booking_jobs")
}

// ---------------------------------------------------------------------------
// Notifications (Phase 1: DB-stored; future: email/Slack/Teams real delivery)
// ---------------------------------------------------------------------------

model Notification {
  id        String               @id @default(uuid())
  bookingId String?              @map("booking_id")
  booking   Booking?             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  channel   NotificationChannel  @default(IN_APP)
  recipient String
  subject   String
  body      String
  status    NotificationStatus   @default(PENDING)
  sentAt    DateTime?            @map("sent_at")
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([bookingId])
  @@map("notifications")
}
