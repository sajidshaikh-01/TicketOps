# --- App ---
NODE_ENV=development
PORT=4002

# --- Database (same Postgres instance as events-api / admin-api) ---
DATABASE_URL=postgresql://ticketops:ticketops@localhost:5432/ticketops?schema=public

# --- Redis (consumes the booking queue, releases seat locks on completion) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Worker tuning ---
# How long the worker blocks on Redis BRPOP waiting for a new job before
# looping again to run the reconciliation sweep.
QUEUE_POLL_TIMEOUT_SECONDS=5
# How often (ms) to sweep the database for stuck/orphaned BookingJob rows
# that Redis never delivered (e.g. after a Redis restart).
RECONCILE_INTERVAL_MS=30000
# A job is considered stuck (eligible for reconciliation) if it has been
# PENDING or stuck in PROCESSING for longer than this.
STUCK_JOB_THRESHOLD_MS=120000
MAX_JOB_ATTEMPTS=5
