# --- App ---
NODE_ENV=development
PORT=4001

# --- Database (same Postgres instance as events-api / bookings-worker) ---
DATABASE_URL=postgresql://ticketops:ticketops@localhost:5432/ticketops?schema=public

# --- JWT ---
# JWT_ACCESS_SECRET must match events-api's value so tokens issued here are
# verifiable there (e.g. for /bookings/me).
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=10

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
