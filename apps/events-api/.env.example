# --- App ---
NODE_ENV=development
PORT=4000

# --- Database (shared Postgres instance, used by all services) ---
DATABASE_URL=postgresql://ticketops:ticketops@localhost:5432/ticketops?schema=public

# --- Redis (seat locking + booking queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Seat locking ---
SEAT_LOCK_TTL_SECONDS=600

# --- JWT (must match admin-api's secret to validate tokens issued there) ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
